          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Is the first consultation really free?",
              "text": "Yes. The first conversation, by phone or in our office, is free and carries no obligation.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Does sending this form make you my lawyer?",
              "text": "No. An attorney-client relationship begins only when we confirm in writing that we will represent you. Please do not send confidential details until then.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "How soon will I hear back?",
              "text": "Usually within one business day. If it is urgent, please call the office.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "What should I bring to a first meeting?",
              "text": "Any documents that relate to your question, such as contracts, letters or court papers, and a short list of what you would like to achieve.",
              "link": "",
              "label": ""
            }
          ]
        }
